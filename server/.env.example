NODE_ENV=development
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_AUTH=false
PORT=3000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173

# Microsoft Entra ID / university AD login.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_API_CLIENT_ID=
MICROSOFT_API_SCOPE=

# Google Calendar external API integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Azure Key Vault. Required in production.
AZURE_KEY_VAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
