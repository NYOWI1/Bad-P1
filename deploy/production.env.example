# Copy this to .env on the VM beside docker-compose.yml.
# Do not put DATABASE_URL, JWT_SECRET, GOOGLE_CLIENT_SECRET, or GOOGLE_REFRESH_TOKEN here for production.
# Those must be stored in Azure Key Vault and loaded at runtime.

WEB_PORT=8081
CLIENT_ORIGIN=https://nyxen.centralindia.cloudapp.azure.com

AZURE_KEY_VAULT_URL=https://your-key-vault-name.vault.azure.net/
# With VM Managed Identity enabled, do not set AZURE_TENANT_ID, AZURE_CLIENT_ID, or AZURE_CLIENT_SECRET here.

MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-frontend-spa-client-id
MICROSOFT_API_CLIENT_ID=your-backend-api-client-id
MICROSOFT_API_SCOPE=api://your-backend-api-client-id/access_as_user

